# ============================================================================
# 生产环境变量（Vite 仅注入 VITE_ 前缀变量，且会明文打包进前端产物）
# ============================================================================
# 生产统一走同源反向代理：前端请求 /api，由 Nginx 转发到后端，
# 避免域名/端口写死，也避免跨域与混合内容（HTTPS 页面请求 HTTP 接口）问题。
VITE_API_BASE_URL=/api

# WebSocket 地址（SockJS 端点，不是原生 ws://，也不能加 /api 前缀）。
# 默认同源 /ws，由 Nginx 代理到后端；如前后端分域部署再改为 wss:// 绝对地址。
VITE_WS_URL=/ws

# 浏览器标题后缀（可选，index.html 已提供默认标题）。
# VITE_APP_TITLE=IoT 设备管理平台
